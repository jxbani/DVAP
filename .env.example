# Copy to .env. No real secrets belong in this repo.
# DVAP's images: ${DVAP_REGISTRY}/dvap-<service>:${DVAP_VERSION}. The version matches the source;
# `./dvap update` bumps it. Point DVAP_REGISTRY at your own registry for a fork.
DVAP_VERSION=0.1.0
DVAP_REGISTRY=ghcr.io/jxbani
PLANT_SEED=0
PLANT_NOISE=0
# easy | medium | hard (which PLC safety interlocks are enabled)
PLC_DIFFICULTY=easy

# Scoreboard
TEAM=solo
# Signs the challenge flags. Change it per deployment; keep it the same across a CTF's team stacks.
DVAP_FLAG_SECRET=change-me

# Host ports (always bound to 127.0.0.1). Give each team stack its own set in CTF mode.
HMI_PORT=8080
CMMS_PORT=8081
SCOREBOARD_PORT=8090

# How the agent thinks. `./dvap up --mode <mode>` sets these four for you.
#   replay  recorded responses, no model needed (Docker: 4 GB memory, 6 GB disk)
#   ollama  local model, offline after a one-time ~4.7 GB download (Docker: 8 GB memory, 12 GB disk)
#           MODEL=ollama/qwen2.5:7b-instruct and COMPOSE_PROFILES=ollama
#   api     hosted model with your key (Docker: 4 GB memory, 6 GB disk), e.g.
#           MODEL=anthropic/claude-sonnet-5-5 and ANTHROPIC_API_KEY, or MODEL=openai/<model> and
#           OPENAI_API_KEY (+ OPENAI_API_BASE for another OpenAI-compatible endpoint)
DVAP_LLM_MODE=replay
MODEL=replay
# What `make model` / ollama mode downloads.
OLLAMA_MODEL=qwen2.5:7b-instruct
# `ollama` starts the local model server; empty in replay and api modes.
COMPOSE_PROFILES=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 1 boots SafeEnvelope on for every challenge (the scoreboard also toggles it per challenge).
DVAP_DEFENDED=
